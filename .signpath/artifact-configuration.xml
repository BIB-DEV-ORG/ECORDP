<?xml version="1.0" encoding="utf-8"?>
<!-- Configuration d'artefact SignPath « windows » : l'artefact GitHub est un zip
     contenant EcoRDP-<version>-x86_64.exe et EcoRDP-<version>-x86_64.msi -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="EcoRDP-*.exe">
      <authenticode-sign />
    </pe-file>
    <msi-file path="EcoRDP-*.msi">
      <authenticode-sign />
    </msi-file>
  </zip-file>
</artifact-configuration>
